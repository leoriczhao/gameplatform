[run]
source =
    backend
    sdk/gamekernel
omit =
    tests/*
    */tests/*
    */__pycache__/*
    .venv/*
    sdk/gameplatform/*
    sdk/examples/*
    web/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.
    raise NotImplementedError
show_missing = True
skip_covered = True
